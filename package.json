{
  "name": "quick-utils",
  "displayName": "Quick Utils",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "kkdev92",
  "author": {
    "name": "kkdev92",
    "url": "https://kkdev92.dev/"
  },
  "license": "MIT",
  "homepage": "https://kkdev92.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kkdev92/quick-utils"
  },
  "bugs": {
    "url": "https://github.com/kkdev92/quick-utils/issues"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "case",
    "base64",
    "json",
    "regex",
    "uuid",
    "hash",
    "hmac",
    "offline"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1b1b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onWebviewPanel:quickUtils.regexTester"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Text is transformed in memory. The extension reads no workspace files unless you pick one — including the shared snippet file, which an untrusted workspace is not read for at all. It spawns no processes other than its own regex worker, and makes no network requests."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "quickUtils.transform",
        "title": "%command.transform.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.transformAgain",
        "title": "%command.transformAgain.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.transformClipboard",
        "title": "%command.transformClipboard.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.transformPipeline",
        "title": "%command.transformPipeline.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.replaceMatches",
        "title": "%command.replaceMatches.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.extractMatches",
        "title": "%command.extractMatches.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.upperCase",
        "title": "%command.upperCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.lowerCase",
        "title": "%command.lowerCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.camelCase",
        "title": "%command.camelCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.pascalCase",
        "title": "%command.pascalCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.snakeCase",
        "title": "%command.snakeCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.kebabCase",
        "title": "%command.kebabCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.constantCase",
        "title": "%command.constantCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.titleCase",
        "title": "%command.titleCase.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.base64Encode",
        "title": "%command.base64Encode.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.base64Decode",
        "title": "%command.base64Decode.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.urlEncode",
        "title": "%command.urlEncode.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.urlDecode",
        "title": "%command.urlDecode.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.sortLines",
        "title": "%command.sortLines.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.dedupeLines",
        "title": "%command.dedupeLines.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.jsonFormat",
        "title": "%command.jsonFormat.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.jsonMinify",
        "title": "%command.jsonMinify.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.jsonSortKeys",
        "title": "%command.jsonSortKeys.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.generateUuid",
        "title": "%command.generateUuid.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.generateUuidV7",
        "title": "%command.generateUuidV7.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.generatePassword",
        "title": "%command.generatePassword.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.generateLorem",
        "title": "%command.generateLorem.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.insertDate",
        "title": "%command.insertDate.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.convertTimestamp",
        "title": "%command.convertTimestamp.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.hash",
        "title": "%command.hash.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.hmac",
        "title": "%command.hmac.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.hmacDefault",
        "title": "%command.hmacDefault.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.manageSecrets",
        "title": "%command.manageSecrets.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.setDefaultSecret",
        "title": "%command.setDefaultSecret.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.inspect",
        "title": "%command.inspect.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.openRegexTester",
        "title": "%command.openRegexTester.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.reportState",
        "title": "%command.reportState.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.collectDiagnostics",
        "title": "%command.collectDiagnostics.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.inspectDocument",
        "title": "%command.inspectDocument.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.history.clear",
        "title": "%command.history.clear.title%",
        "category": "Quick Utils",
        "icon": "$(clear-all)"
      },
      {
        "command": "quickUtils.history.copy",
        "title": "%command.history.copy.title%",
        "category": "Quick Utils",
        "icon": "$(clippy)"
      },
      {
        "command": "quickUtils.history.reapply",
        "title": "%command.history.reapply.title%",
        "category": "Quick Utils",
        "icon": "$(redo)"
      },
      {
        "command": "quickUtils.history.loadMore",
        "title": "%command.history.loadMore.title%",
        "category": "Quick Utils"
      },
      {
        "command": "quickUtils.tools.resetFavorites",
        "title": "%command.tools.resetFavorites.title%",
        "category": "Quick Utils",
        "icon": "$(star-empty)"
      },
      {
        "command": "quickUtils.insertPreset",
        "title": "%command.insertPreset.title%",
        "category": "Quick Utils",
        "icon": "$(symbol-snippet)"
      },
      {
        "command": "quickUtils.reloadPresets",
        "title": "%command.reloadPresets.title%",
        "category": "Quick Utils",
        "icon": "$(refresh)"
      },
      {
        "command": "quickUtils.watchFiles",
        "title": "%command.watchFiles.title%",
        "category": "Quick Utils",
        "icon": "$(eye)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quickUtils",
          "title": "Quick Utils",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "quickUtils": [
        {
          "id": "quickUtils.tools",
          "name": "%view.tools.name%",
          "icon": "media/icon.svg"
        },
        {
          "id": "quickUtils.history",
          "name": "%view.history.name%",
          "icon": "media/icon.svg"
        },
        {
          "id": "quickUtils.scratchpad",
          "name": "%view.scratchpad.name%",
          "type": "webview",
          "icon": "media/icon.svg",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "quickUtils.history",
        "contents": "%view.history.welcome%"
      }
    ],
    "submenus": [
      {
        "id": "quickUtils.submenu",
        "label": "Quick Utils"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "quickUtils.submenu",
          "group": "1_modification@100"
        }
      ],
      "quickUtils.submenu": [
        {
          "command": "quickUtils.transform",
          "group": "1_transform@1"
        },
        {
          "command": "quickUtils.transformAgain",
          "group": "1_transform@2"
        },
        {
          "command": "quickUtils.transformPipeline",
          "group": "1_transform@3"
        },
        {
          "command": "quickUtils.replaceMatches",
          "group": "2_pattern@1"
        },
        {
          "command": "quickUtils.hash",
          "group": "3_inspect@1"
        },
        {
          "command": "quickUtils.inspect",
          "group": "3_inspect@2"
        },
        {
          "command": "quickUtils.extractMatches",
          "group": "2_pattern@2"
        }
      ],
      "view/title": [
        {
          "command": "quickUtils.tools.resetFavorites",
          "when": "view == quickUtils.tools",
          "group": "navigation@1"
        },
        {
          "command": "quickUtils.history.clear",
          "when": "view == quickUtils.history",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "quickUtils.history.reapply",
          "when": "view == quickUtils.history && viewItem =~ /^historyEntry/",
          "group": "inline@1"
        },
        {
          "command": "quickUtils.history.copy",
          "when": "view == quickUtils.history && viewItem == historyEntryWithOutput",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "quickUtils.history.copy",
          "when": "false"
        },
        {
          "command": "quickUtils.history.reapply",
          "when": "false"
        },
        {
          "command": "quickUtils.history.loadMore",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "quickUtils.transform",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      },
      {
        "command": "quickUtils.transformAgain",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Quick Utils",
      "properties": {
        "quickUtils.logLevel": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "%config.logLevel.description%"
        },
        "quickUtils.datePatterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "YYYY-MM-DD",
            "YYYY-MM-DD HH:mm:ss",
            "YYYY-MM-DD[T]HH:mm:ssZ",
            "YYYY/MM/DD",
            "MM/DD/YYYY",
            "DD/MM/YYYY",
            "HH:mm:ss",
            "YYYYMMDD"
          ],
          "description": "%config.datePatterns.description%"
        },
        "quickUtils.jsonIndent": {
          "type": "string",
          "enum": [
            "editor",
            "2",
            "4",
            "tab"
          ],
          "enumDescriptions": [
            "%config.jsonIndent.editor%",
            "%config.jsonIndent.two%",
            "%config.jsonIndent.four%",
            "%config.jsonIndent.tab%"
          ],
          "default": "editor",
          "description": "%config.jsonIndent.description%"
        },
        "quickUtils.historySize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 100,
          "description": "%config.historySize.description%"
        },
        "quickUtils.historyPageSize": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500,
          "default": 50,
          "description": "%config.historyPageSize.description%"
        },
        "quickUtils.hashAlgorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512",
            "sha384",
            "sha1",
            "md5"
          ],
          "default": "sha256",
          "description": "%config.hashAlgorithm.description%"
        },
        "quickUtils.hmacKeyEncoding": {
          "type": "string",
          "enum": [
            "utf8",
            "hex",
            "base64"
          ],
          "enumDescriptions": [
            "%config.hmacKeyEncoding.utf8%",
            "%config.hmacKeyEncoding.hex%",
            "%config.hmacKeyEncoding.base64%"
          ],
          "default": "utf8",
          "description": "%config.hmacKeyEncoding.description%"
        },
        "quickUtils.passwordLength": {
          "type": "integer",
          "minimum": 8,
          "maximum": 128,
          "default": 20,
          "description": "%config.passwordLength.description%"
        },
        "quickUtils.regexTimeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000,
          "default": 2000,
          "description": "%config.regexTimeoutMs.description%"
        },
        "quickUtils.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBar.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle:prod",
    "bundle": "node scripts/build.mjs",
    "bundle:prod": "node scripts/build.mjs --production",
    "bundle:watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p src/webview --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "check:l10n": "node scripts/l10n.mjs",
    "l10n:write": "node scripts/l10n.mjs --write",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run bundle && vitest run --project integration",
    "test:eh": "npm run bundle && node test/eh/run.mjs",
    "demo:eh": "npm run bundle && node test/eh/run.mjs --demo",
    "test:coverage": "vitest run --project unit --coverage",
    "package": "vsce package --no-dependencies --out quick-utils.vsix",
    "verify:vsix": "node scripts/verify-vsix.mjs",
    "install-local": "npm run package && code --install-extension quick-utils.vsix --force",
    "uninstall-local": "code --uninstall-extension kkdev92.quick-utils",
    "clean": "rimraf dist coverage .vsix-verify-temp quick-utils.vsix"
  },
  "dependencies": {
    "@kkdev92/vscode-ext-kit": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.13.3",
    "@types/vscode": "~1.125.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
