{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Bundle the extension host and the regex worker into dist/",
      "type": "shell",
      "command": "npm",
      "args": ["run", "bundle"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$esbuild"
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "npm",
      "args": ["run", "bundle:watch"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": "$esbuild-watch"
    },
    {
      "label": "test",
      "detail": "Unit tests, then integration tests against the built bundles",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
