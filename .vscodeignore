# Sources are bundled into dist/; ship only the bundles and runtime assets.
src/**
test/**
scripts/**
node_modules/**
coverage/**
out/**
.vscode-test/**
work/**
artifacts/**
.clipshot/**
.vsix-verify-temp/**

# Development configuration
.vscode/**
.github/**
.claude/**
.gitignore
.mcp.json
tsconfig.json
eslint.config.mjs
vitest.config.mts
package-lock.json

# Environment and secrets — never ship these, whatever else changes here
.env
.env.*
*.pem
*.key

# Docs that live on GitHub, not in the package (README/LICENSE/CHANGELOG ship
# automatically). THIRD_PARTY_NOTICES.md and third-party/ must NOT be added
# here: the MIT licence of the code bundled into dist/ requires its notice to
# travel with the VSIX.
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
sample.md

# Build noise
**/*.map
*.vsix
